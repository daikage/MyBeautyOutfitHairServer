# Copy this file to `server/.env` and change the values (especially the passcode).

# Port the API listens on
PORT=4000

# Passcode used on the /admin page to upload new styles and read bookings.
# CHANGE THIS before putting the site online!
ADMIN_PASSCODE=change-me-glam2026

# ─── Supabase / PostgreSQL (REQUIRED) ───────────────────────────────────────
# ALL bookings + styles are stored here. Without it the server will not start.
#
# Supabase dashboard -> Project Settings -> Database -> Connection string -> URI
# Use the CONNECTION POOLING string (Session mode, port 5432) on Render:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Add it on Render (Settings -> Environment):
#   DATABASE_URL = postgresql://...
#
# Locally put the same value in server/.env (a local Postgres works too).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ─── Cloudinary (REQUIRED for Render.com / any ephemeral-disk host) ──────────
# Sign up free at https://cloudinary.com, go to Dashboard > Product Environment
# Credentials and copy the "API environment variable" value. It looks like:
#   cloudinary://123456789012345:abcDEFghiJKLmnoPQRstu-vWxYz@your-cloud-name
#
# Set this as an environment variable in Render.com dashboard:
#   Settings → Environment → Add Environment Variable → key: CLOUDINARY_URL
#
# Without this, uploaded images are saved to disk and WILL BE LOST when
# Render restarts or redeploys your service.
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME